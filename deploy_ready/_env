# ── App identity ─────────────────────────────────────────────────────────
COMPANY_NAME=CityFoam
PORT=8000
THEME=dark
ENABLE_SIDEBAR=true

# ── LLM provider ──────────────────────────────────────────────────────────
LLM_PROVIDER=azure        # "ollama" | "azure"

# ── Ollama (used when LLM_PROVIDER=ollama) ────────────────────────────────
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# ── Azure OpenAI ──────────────────────────────────────────────────────────
# PREFERRED: store these in Azure Key Vault and set only AZURE_KEYVAULT_URL.
# For local dev, you can keep them here — they are the fallback.
AZURE_ENDPOINT=https://llm-standalone.openai.azure.com/
AZURE_API_KEY=your-key-here
AZURE_API_VERSION=2024-12-01-preview
AZURE_DEPLOYMENT_NAME=gpt-4o-standalone-resource

# ── Secret management ─────────────────────────────────────────────────────
# When set, secrets.py will pull ALL secrets from Key Vault first.
# Secret names in Key Vault use hyphens:  AZURE-API-KEY, CITYFOAM-SECRET-KEY
# Leave blank to use environment variables only (local dev).
AZURE_KEYVAULT_URL=

# ── Security ──────────────────────────────────────────────────────────────
REQUIRE_API_KEY=false        # set true to enforce X-API-Key on /api/chat/stream
CITYFOAM_SECRET_KEY=change_me_in_production
CITYFOAM_ADMIN_KEY=change_this_admin_key   # required for all /admin/* endpoints

# ── MLflow / Azure ML ─────────────────────────────────────────────────────
# Local dev: leave blank → runs saved to ./mlruns/
# Azure ML : set to your workspace URI (shown in Azure ML Studio → Settings)
#   azureml://eastus.api.azureml.ms/mlflow/v1.0/subscriptions/<SUB>/
#   resourceGroups/<RG>/providers/Microsoft.MachineLearningServices/workspaces/<WS>
MLFLOW_TRACKING_URI=
ENV=production        # controls MLflow experiment name (production | staging)


CHROMA_DB_DIR=./chroma_db
DATA_DIR=./data
COLLECTION_NAME=cityfoam_rag

# ── Retraining Scheduler ──────────────────────────────────────────────────────
# Standard 5-field cron (UTC). Default: every Sunday at 02:00 UTC
# Examples:
#   "0 2 * * 0"    — every Sunday 2am
#   "0 */6 * * *"  — every 6 hours
#   "0 3 * * 1-5"  — weekdays at 3am
REINGEST_SCHEDULE=0 2 * * 0

# Run ingest automatically at startup if ChromaDB has fewer than N chunks
REINGEST_ON_STARTUP=false
MIN_CHUNKS_THRESHOLD=10
